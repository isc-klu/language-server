{
	"compilerOptions": {
		"target": "es2019",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"sourceMap": true,
		"strict": true,
		"strictNullChecks": true,
		"outDir": "out",
		"rootDir": "src",
		"noImplicitAny": false,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"allowJs": true,
		"skipLibCheck": true,
		"types": ["node"],
	},
	"references": [
		{
			"path": "../common"
		}
	],
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test"]
}
